{
  "schema_version": 3,
  "id": "world_provider_aimlapi",
  "name": "AI/ML API",
  "description": "Models from many vendors through one AI/ML API key.",
  "category": "provider",
  "developer": "AI/ML API",
  "version": "1.0.0",
  "icon": "sparkles",
  "interfaces": [
    "world_provider_aimlapi"
  ],
  "setup": {
    "fields": [
      {
        "interface": "world_provider_aimlapi",
        "pointer": "/interface_driver_config/transport/auth_env_key",
        "label": "AI/ML API key",
        "kind": "secret",
        "required": true
      },
      {
        "interface": "world_provider_aimlapi",
        "pointer": "/interface_driver_config/private_config/opencodex/model_env",
        "label": "Optional model id from the AI/ML API catalog, for example alibaba/qwen3.8-flash",
        "kind": "text",
        "required": false
      }
    ]
  }
}
